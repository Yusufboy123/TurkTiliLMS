PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/turk_tili_lms
# Use a disposable PostgreSQL database with all migrations applied.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/turk_tili_lms_test
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ISSUER=turk-tili-lms-api
JWT_AUDIENCE=turk-tili-lms-clients
BCRYPT_ROUNDS=12
SEED_DEVELOPMENT_USERS=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REFRESH_COOKIE_NAME=turk_tili_refresh
# Must be true in production. Local HTTP development uses false.
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
MEDIA_STORAGE_ROOT=uploads
MEDIA_MAX_UPLOAD_BYTES=262144000
CERTIFICATE_ARTIFACT_STORAGE_ROOT=private-certificate-artifacts
CERTIFICATE_PDF_MAX_BYTES=10485760
CERTIFICATE_PDF_RENDER_TIMEOUT_MS=10000
