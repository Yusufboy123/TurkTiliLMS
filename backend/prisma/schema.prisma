generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED

  @@map("user_status")
}

enum RoleCode {
  ADMIN
  TEACHER
  STUDENT

  @@map("role_code")
}

enum SessionClientType {
  WEB
  ANDROID
  IOS
  TELEGRAM
  OTHER

  @@map("session_client_type")
}

enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("course_level")
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("course_status")
}

enum CourseEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED

  @@map("course_enrollment_status")
}

enum CourseEnrollmentSource {
  SELF
  ADMIN

  @@map("course_enrollment_source")
}

/// NOT_STARTED is intentionally absent: a missing BlockProgress row represents
/// that state under the approved sparse progress model.
enum BlockProgressState {
  INCOMPLETE
  COMPLETED

  @@map("block_progress_state")
}

/// NOT_STARTED and READY_TO_COMPLETE are derived projections and are not stored.
enum LessonProgressState {
  IN_PROGRESS
  COMPLETED

  @@map("lesson_progress_state")
}

enum ProgressEventType {
  BLOCK_COMPLETED
  BLOCK_REOPENED
  LESSON_COMPLETED
  LESSON_REOPENED
  COURSE_COMPLETED

  @@map("progress_event_type")
}

/// This shared event vocabulary records before/after state without exposing
/// internal event rows through the public API.
enum ProgressEventState {
  NOT_STARTED
  INCOMPLETE
  IN_PROGRESS
  COMPLETED

  @@map("progress_event_state")
}

enum IdempotencyOperation {
  COMPLETE_BLOCK
  REOPEN_BLOCK
  COMPLETE_LESSON
  REOPEN_LESSON
  RECORD_LAST_VISITED_LESSON

  @@map("idempotency_operation")
}

enum LessonType {
  TEXT
  VIDEO
  AUDIO
  PDF
  QUIZ
  ASSIGNMENT
  LIVE

  @@map("lesson_type")
}

enum LessonStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("lesson_status")
}

enum LessonContentBlockType {
  TEXT
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  IMAGE
  LINK
  DOWNLOAD

  @@map("lesson_content_block_type")
}

enum MediaCategory {
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO

  @@map("media_category")
}

enum MediaStorageProvider {
  LOCAL

  @@map("media_storage_provider")
}

model User {
  id                    String               @id @default(uuid(7)) @db.Uuid
  email                 String               @unique(map: "users_email_key") @db.Citext
  firstName             String?              @map("first_name") @db.VarChar(100)
  lastName              String?              @map("last_name") @db.VarChar(100)
  displayName           String?              @map("display_name") @db.VarChar(160)
  status                UserStatus           @default(ACTIVE)
  emailVerifiedAt       DateTime?            @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt           DateTime?            @map("last_login_at") @db.Timestamptz(3)
  deletedAt             DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential            UserCredential?
  sessions              UserSession[]
  roles                 UserRole[]           @relation("UserRoleUser")
  roleAssignmentsMade   UserRole[]           @relation("UserRoleAssigner")
  permissionGrantsMade  RolePermission[]     @relation("RolePermissionGranter")
  auditLogs             AuditLog[]           @relation("AuditLogActor")
  coursesCreated        Course[]             @relation("CourseCreator")
  coursesTaught         Course[]             @relation("CourseTeacher")
  courseSectionsCreated CourseSection[]      @relation("CourseSectionCreator")
  lessonsCreated        Lesson[]             @relation("LessonCreator")
  lessonsTaught         Lesson[]             @relation("LessonTeacher")
  lessonBlocksCreated   LessonContentBlock[] @relation("LessonContentBlockCreator")
  mediaFilesUploaded    MediaFile[]          @relation("MediaFileUploader")
  courseEnrollments     CourseEnrollment[]   @relation("CourseEnrollmentStudent")
  enrollmentsCreated    CourseEnrollment[]   @relation("CourseEnrollmentCreator")
  progressEvents        ProgressEvent[]      @relation("ProgressEventActor")
  idempotencyRecords    IdempotencyRecord[]  @relation("IdempotencyRecordActor")

  @@index([status, createdAt], map: "users_status_created_at_idx")
  @@index([lastName, firstName], map: "users_last_name_first_name_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

/// Local password security state is isolated from the general user profile.
/// Only an adaptive password hash is stored; plaintext passwords never persist.
model UserCredential {
  userId                 String    @id @map("user_id") @db.Uuid
  passwordHash           String    @map("password_hash") @db.Text
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  lockedUntil            DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt      DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  requiresPasswordChange Boolean   @default(false) @map("requires_password_change")
  /// Password reset tokens are random, single-use values stored only as hashes.
  passwordResetTokenHash String?   @unique(map: "user_credentials_password_reset_token_hash_key") @map("password_reset_token_hash") @db.VarChar(128)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([lockedUntil], map: "user_credentials_locked_until_idx")
  @@index([passwordResetExpiresAt], map: "user_credentials_password_reset_expires_at_idx")
  @@map("user_credentials")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        RoleCode         @unique(map: "roles_code_key")
  name        String           @db.VarChar(100)
  description String?          @db.Text
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@index([isSystem], map: "roles_is_system_idx")
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique(map: "permissions_code_key") @db.VarChar(100)
  resource    String           @db.VarChar(64)
  action      String           @db.VarChar(64)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@unique([resource, action], map: "permissions_resource_action_key")
  @@map("permissions")
}

model UserRole {
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  user             User      @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role             Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy       User?     @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@id([userId, roleId], map: "user_roles_pkey")
  @@index([roleId, userId], map: "user_roles_role_id_user_id_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_user_id_idx")
  @@index([expiresAt], map: "user_roles_expires_at_idx")
  @@map("user_roles")
}

model RolePermission {
  roleId          String     @map("role_id") @db.Uuid
  permissionId    String     @map("permission_id") @db.Uuid
  grantedByUserId String?    @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime   @default(now()) @map("granted_at") @db.Timestamptz(3)
  role            Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy       User?      @relation("RolePermissionGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@id([roleId, permissionId], map: "role_permissions_pkey")
  @@index([permissionId, roleId], map: "role_permissions_permission_id_role_id_idx")
  @@index([grantedByUserId], map: "role_permissions_granted_by_user_id_idx")
  @@map("role_permissions")
}

model UserSession {
  id                  String            @id @default(uuid(7)) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  /// Refresh tokens are stored only as cryptographic hashes and are never recoverable.
  refreshTokenHash    String            @unique(map: "user_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.VarChar(128)
  tokenFamilyId       String            @map("token_family_id") @db.Uuid
  clientType          SessionClientType @default(WEB) @map("client_type")
  deviceName          String?           @map("device_name") @db.VarChar(160)
  /// Raw IP retention must be bounded; anonymize or hash it according to privacy policy.
  ipAddress           String?           @map("ip_address") @db.Inet
  userAgent           String?           @map("user_agent") @db.Text
  lastActivityAt      DateTime          @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revocationReason    String?           @map("revocation_reason") @db.VarChar(255)
  replacedBySessionId String?           @unique(map: "user_sessions_replaced_by_session_id_key") @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy          UserSession?      @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces            UserSession?      @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt], map: "user_sessions_user_id_revoked_at_expires_at_idx")
  @@index([tokenFamilyId], map: "user_sessions_token_family_id_idx")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@index([lastActivityAt], map: "user_sessions_last_activity_at_idx")
  @@map("user_sessions")
}

/// Audit records are append-only. Summaries must never contain passwords,
/// tokens, secrets, or unnecessary personal data.
model AuditLog {
  id                   String   @id @default(uuid(7)) @db.Uuid
  actorUserId          String?  @map("actor_user_id") @db.Uuid
  action               String   @db.VarChar(100)
  subjectType          String   @map("subject_type") @db.VarChar(100)
  subjectId            String?  @map("subject_id") @db.Uuid
  requestCorrelationId String?  @map("request_correlation_id") @db.Uuid
  ipHash               String?  @map("ip_hash") @db.Char(64)
  userAgentSummary     String?  @map("user_agent_summary") @db.VarChar(512)
  beforeSummary        Json?    @map("before_summary")
  afterSummary         Json?    @map("after_summary")
  metadata             Json?
  occurredAt           DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actor                User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorUserId, occurredAt], map: "audit_logs_actor_user_id_occurred_at_idx")
  @@index([subjectType, subjectId, occurredAt], map: "audit_logs_subject_type_subject_id_occurred_at_idx")
  @@index([action, occurredAt], map: "audit_logs_action_occurred_at_idx")
  @@index([requestCorrelationId], map: "audit_logs_request_correlation_id_idx")
  @@index([occurredAt], map: "audit_logs_occurred_at_idx")
  @@map("audit_logs")
}

/// Course content fields represent the course's current primary content language.
/// `contentLanguage` uses a BCP 47-compatible code so future languages are not
/// coupled to the initial Turkish catalog.
model Course {
  id                       String             @id @default(uuid(7)) @db.Uuid
  title                    String             @db.VarChar(200)
  slug                     String             @unique(map: "courses_slug_key") @db.VarChar(180)
  shortDescription         String?            @map("short_description") @db.VarChar(500)
  description              String?            @db.Text
  coverImageUrl            String?            @map("cover_image_url") @db.Text
  contentLanguage          String             @default("tr") @map("content_language") @db.VarChar(35)
  level                    CourseLevel?
  status                   CourseStatus       @default(DRAFT)
  createdByUserId          String             @map("created_by_user_id") @db.Uuid
  teacherId                String?            @map("teacher_id") @db.Uuid
  estimatedDurationMinutes Int?               @map("estimated_duration_minutes")
  sortOrder                Int                @default(0) @map("sort_order")
  isFeatured               Boolean            @default(false) @map("is_featured")
  curriculumVersion        Int                @default(1) @map("curriculum_version")
  publishedAt              DateTime?          @map("published_at") @db.Timestamptz(3)
  archivedAt               DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdBy                User               @relation("CourseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher                  User?              @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sections                 CourseSection[]
  lessons                  Lesson[]
  enrollments              CourseEnrollment[]

  @@index([status, deletedAt, sortOrder], map: "courses_status_deleted_at_sort_order_idx")
  @@index([teacherId, status, deletedAt], map: "courses_teacher_id_status_deleted_at_idx")
  @@index([createdByUserId], map: "courses_created_by_user_id_idx")
  @@index([level, status, deletedAt], map: "courses_level_status_deleted_at_idx")
  @@index([isFeatured, status, deletedAt], map: "courses_is_featured_status_deleted_at_idx")
  @@index([contentLanguage, status, deletedAt], map: "courses_content_language_status_deleted_at_idx")
  @@index([publishedAt], map: "courses_published_at_idx")
  @@index([deletedAt], map: "courses_deleted_at_idx")
  @@map("courses")
}

/// Enrollment rows are lifecycle records. A cancelled enrollment is retained and
/// a later explicit re-enrollment creates a new row so historical events remain auditable.
/// Current-membership uniqueness is enforced by a PostgreSQL partial unique index.
model CourseEnrollment {
  id           String                  @id @default(uuid(7)) @db.Uuid
  courseId     String                  @map("course_id") @db.Uuid
  studentId    String                  @map("student_id") @db.Uuid
  status       CourseEnrollmentStatus  @default(ACTIVE)
  source       CourseEnrollmentSource
  enrolledAt   DateTime                @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  startedAt    DateTime?               @map("started_at") @db.Timestamptz(3)
  completedAt  DateTime?               @map("completed_at") @db.Timestamptz(3)
  cancelledAt  DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  suspendedAt  DateTime?               @map("suspended_at") @db.Timestamptz(3)
  createdById  String?                 @map("created_by_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  course       Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student      User                    @relation("CourseEnrollmentStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User?                   @relation("CourseEnrollmentCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  progressRoot EnrollmentProgressRoot?

  @@index([studentId, status, enrolledAt], map: "course_enrollments_student_id_status_enrolled_at_idx")
  @@index([courseId, status, enrolledAt], map: "course_enrollments_course_id_status_enrolled_at_idx")
  @@index([courseId, studentId, enrolledAt], map: "course_enrollments_course_id_student_id_enrolled_at_idx")
  @@index([createdById], map: "course_enrollments_created_by_id_idx")
  @@index([completedAt], map: "course_enrollments_completed_at_idx")
  @@index([createdAt], map: "course_enrollments_created_at_idx")
  @@map("course_enrollments")
}

/// One root owns the authoritative snapshot and activity cursor for exactly one
/// enrollment lifecycle. Progress records are intentionally not soft-deleted.
model EnrollmentProgressRoot {
  id                      String              @id @default(uuid(7)) @db.Uuid
  enrollmentId            String              @unique(map: "enrollment_progress_roots_enrollment_id_key") @map("enrollment_id") @db.Uuid
  lastVisitedLessonId     String?             @map("last_visited_lesson_id") @db.Uuid
  lastVisitedAt           DateTime?           @map("last_visited_at") @db.Timestamptz(3)
  firstActivityAt         DateTime?           @map("first_activity_at") @db.Timestamptz(3)
  completionVersion       Int                 @default(0) @map("completion_version")
  activityVersion         Int                 @default(0) @map("activity_version")
  curriculumVersion       Int                 @default(1) @map("curriculum_version")
  completedEligibleBlocks Int                 @default(0) @map("completed_eligible_blocks")
  totalEligibleBlocks     Int                 @default(0) @map("total_eligible_blocks")
  completedLessons        Int                 @default(0) @map("completed_lessons")
  totalEligibleLessons    Int                 @default(0) @map("total_eligible_lessons")
  coursePercentage        Int                 @default(0) @map("course_percentage")
  frozenAt                DateTime?           @map("frozen_at") @db.Timestamptz(3)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment              CourseEnrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastVisitedLesson       Lesson?             @relation("EnrollmentProgressLastVisitedLesson", fields: [lastVisitedLessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessonProgress          LessonProgress[]
  blockProgress           BlockProgress[]
  events                  ProgressEvent[]
  idempotencyRecords      IdempotencyRecord[]

  @@index([lastVisitedAt, enrollmentId], map: "enrollment_progress_roots_last_visited_at_enrollment_id_idx")
  @@index([frozenAt], map: "enrollment_progress_roots_frozen_at_idx")
  @@map("enrollment_progress_roots")
}

/// Persisted lesson state is enrollment-scoped. NOT_STARTED and
/// READY_TO_COMPLETE remain derived so they cannot become stale stored states.
model LessonProgress {
  id                String                 @id @default(uuid(7)) @db.Uuid
  enrollmentId      String                 @map("enrollment_id") @db.Uuid
  lessonId          String                 @map("lesson_id") @db.Uuid
  state             LessonProgressState    @default(IN_PROGRESS)
  curriculumVersion Int                    @map("curriculum_version")
  firstActivityAt   DateTime               @default(now()) @map("first_activity_at") @db.Timestamptz(3)
  lastActivityAt    DateTime               @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  progressRoot      EnrollmentProgressRoot @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict, onUpdate: Cascade)
  lesson            Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, lessonId], map: "lesson_progress_enrollment_id_lesson_id_key")
  @@index([enrollmentId, state, lessonId], map: "lesson_progress_enrollment_id_state_lesson_id_idx")
  @@index([lessonId, state], map: "lesson_progress_lesson_id_state_idx")
  @@index([enrollmentId, lastActivityAt], map: "lesson_progress_enrollment_id_last_activity_at_idx")
  @@index([completedAt], map: "lesson_progress_completed_at_idx")
  @@map("lesson_progress")
}

/// A missing row is NOT_STARTED. Only explicit INCOMPLETE and COMPLETED states
/// are persisted, preserving sparse storage and reopen history.
model BlockProgress {
  id                String                 @id @default(uuid(7)) @db.Uuid
  enrollmentId      String                 @map("enrollment_id") @db.Uuid
  blockId           String                 @map("block_id") @db.Uuid
  state             BlockProgressState
  curriculumVersion Int                    @map("curriculum_version")
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  progressRoot      EnrollmentProgressRoot @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict, onUpdate: Cascade)
  block             LessonContentBlock     @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, blockId], map: "block_progress_enrollment_id_block_id_key")
  @@index([enrollmentId, state, blockId], map: "block_progress_enrollment_id_state_block_id_idx")
  @@index([blockId, state], map: "block_progress_block_id_state_idx")
  @@index([completedAt], map: "block_progress_completed_at_idx")
  @@map("block_progress")
}

/// Fixed-column, append-only progress history. It is neither a public event
/// stream nor an unrestricted analytics payload.
model ProgressEvent {
  id                              String                 @id @default(uuid(7)) @db.Uuid
  enrollmentId                    String                 @map("enrollment_id") @db.Uuid
  actorUserId                     String?                @map("actor_user_id") @db.Uuid
  eventType                       ProgressEventType      @map("event_type")
  lessonId                        String?                @map("lesson_id") @db.Uuid
  blockId                         String?                @map("block_id") @db.Uuid
  previousState                   ProgressEventState     @map("previous_state")
  newState                        ProgressEventState     @map("new_state")
  curriculumVersion               Int                    @map("curriculum_version")
  resultingCompletionVersion      Int                    @map("resulting_completion_version")
  idempotencyRecordId             String?                @map("idempotency_record_id") @db.Uuid
  requestCorrelationId            String?                @map("request_correlation_id") @db.Uuid
  snapshotCompletedEligibleBlocks Int?                   @map("snapshot_completed_eligible_blocks")
  snapshotTotalEligibleBlocks     Int?                   @map("snapshot_total_eligible_blocks")
  snapshotCompletedLessons        Int?                   @map("snapshot_completed_lessons")
  snapshotTotalEligibleLessons    Int?                   @map("snapshot_total_eligible_lessons")
  snapshotCoursePercentage        Int?                   @map("snapshot_course_percentage")
  occurredAt                      DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(3)
  progressRoot                    EnrollmentProgressRoot @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict, onUpdate: Cascade)
  actor                           User?                  @relation("ProgressEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lesson                          Lesson?                @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  block                           LessonContentBlock?    @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  idempotencyRecord               IdempotencyRecord?     @relation(fields: [idempotencyRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([enrollmentId, occurredAt], map: "progress_events_enrollment_id_occurred_at_idx")
  @@index([actorUserId, occurredAt], map: "progress_events_actor_user_id_occurred_at_idx")
  @@index([lessonId, occurredAt], map: "progress_events_lesson_id_occurred_at_idx")
  @@index([blockId, occurredAt], map: "progress_events_block_id_occurred_at_idx")
  @@index([eventType, occurredAt], map: "progress_events_event_type_occurred_at_idx")
  @@index([idempotencyRecordId], map: "progress_events_idempotency_record_id_idx")
  @@map("progress_events")
}

/// Successful mutation responses are retained for bounded actor-isolated
/// replay. Authentication and authorization must still be revalidated.
model IdempotencyRecord {
  id                         String                 @id @default(uuid(7)) @db.Uuid
  actorUserId                String                 @map("actor_user_id") @db.Uuid
  enrollmentId               String                 @map("enrollment_id") @db.Uuid
  key                        String                 @db.VarChar(128)
  operation                  IdempotencyOperation
  requestFingerprint         String                 @map("request_fingerprint") @db.Char(64)
  responseStatus             Int                    @map("response_status") @db.SmallInt
  responseEnvelope           Json                   @map("response_envelope")
  resultingCompletionVersion Int?                   @map("resulting_completion_version")
  resultingActivityVersion   Int?                   @map("resulting_activity_version")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt                  DateTime               @map("expires_at") @db.Timestamptz(3)
  actor                      User                   @relation("IdempotencyRecordActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  progressRoot               EnrollmentProgressRoot @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict, onUpdate: Cascade)
  events                     ProgressEvent[]

  @@unique([actorUserId, key], map: "idempotency_records_actor_user_id_key_key")
  @@index([enrollmentId, createdAt], map: "idempotency_records_enrollment_id_created_at_idx")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@index([operation, createdAt], map: "idempotency_records_operation_created_at_idx")
  @@map("idempotency_records")
}

model CourseSection {
  id          String    @id @default(uuid(7)) @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String?   @db.Text
  /// Active sibling uniqueness is enforced by a PostgreSQL partial index in
  /// the migration so soft-deleted rows can retain their historical position.
  position    Int
  isPublished Boolean   @default(false) @map("is_published")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User      @relation("CourseSectionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessons     Lesson[]

  @@unique([id, courseId], map: "course_sections_id_course_id_key")
  @@index([courseId, deletedAt, position], map: "course_sections_course_id_deleted_at_position_idx")
  @@index([courseId, isPublished, deletedAt], map: "course_sections_course_id_is_published_deleted_at_idx")
  @@index([createdById], map: "course_sections_created_by_id_idx")
  @@index([deletedAt], map: "course_sections_deleted_at_idx")
  @@map("course_sections")
}

model Lesson {
  id                       String                   @id @default(uuid(7)) @db.Uuid
  courseId                 String                   @map("course_id") @db.Uuid
  sectionId                String                   @map("section_id") @db.Uuid
  title                    String                   @db.VarChar(200)
  slug                     String                   @db.VarChar(180)
  summary                  String?                  @db.Text
  content                  String?                  @db.Text
  lessonType               LessonType               @map("lesson_type")
  /// Active sibling uniqueness is enforced by a PostgreSQL partial index in
  /// the migration so soft-deleted rows can retain their historical position.
  position                 Int
  durationMinutes          Int?                     @map("duration_minutes")
  isPreview                Boolean                  @default(false) @map("is_preview")
  status                   LessonStatus             @default(DRAFT)
  createdById              String                   @map("created_by_id") @db.Uuid
  teacherId                String?                  @map("teacher_id") @db.Uuid
  publishedAt              DateTime?                @map("published_at") @db.Timestamptz(3)
  archivedAt               DateTime?                @map("archived_at") @db.Timestamptz(3)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?                @map("deleted_at") @db.Timestamptz(3)
  course                   Course                   @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  section                  CourseSection            @relation(fields: [sectionId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: Cascade)
  createdBy                User                     @relation("LessonCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher                  User?                    @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contentBlocks            LessonContentBlock[]
  lastVisitedProgressRoots EnrollmentProgressRoot[] @relation("EnrollmentProgressLastVisitedLesson")
  progress                 LessonProgress[]
  progressEvents           ProgressEvent[]

  @@unique([courseId, slug], map: "lessons_course_id_slug_key")
  @@index([courseId, status, deletedAt], map: "lessons_course_id_status_deleted_at_idx")
  @@index([sectionId, deletedAt, position], map: "lessons_section_id_deleted_at_position_idx")
  @@index([teacherId, status, deletedAt], map: "lessons_teacher_id_status_deleted_at_idx")
  @@index([lessonType, status, deletedAt], map: "lessons_lesson_type_status_deleted_at_idx")
  @@index([createdById], map: "lessons_created_by_id_idx")
  @@index([deletedAt], map: "lessons_deleted_at_idx")
  @@map("lessons")
}

/// Ordered lesson content keeps delivery references and metadata only. Binary
/// payload ownership belongs to MediaFile and its storage-provider adapter.
model LessonContentBlock {
  id               String                 @id @default(uuid(7)) @db.Uuid
  lessonId         String                 @map("lesson_id") @db.Uuid
  mediaFileId      String?                @map("media_file_id") @db.Uuid
  blockType        LessonContentBlockType @map("block_type")
  title            String?                @db.VarChar(200)
  description      String?                @db.Text
  /// Active sibling uniqueness is enforced by a PostgreSQL partial index in
  /// the migration so soft-deleted blocks retain their historical position.
  position         Int
  isRequired       Boolean                @default(true) @map("is_required")
  isVisible        Boolean                @default(true) @map("is_visible")
  textContent      String?                @map("text_content") @db.Text
  sourceUrl        String?                @map("source_url") @db.Text
  externalProvider String?                @map("external_provider") @db.VarChar(100)
  fileName         String?                @map("file_name") @db.VarChar(255)
  originalFileName String?                @map("original_file_name") @db.VarChar(255)
  fileUrl          String?                @map("file_url") @db.Text
  mimeType         String?                @map("mime_type") @db.VarChar(160)
  fileSizeBytes    BigInt?                @map("file_size_bytes") @db.BigInt
  durationSeconds  Int?                   @map("duration_seconds")
  thumbnailUrl     String?                @map("thumbnail_url") @db.Text
  metadata         Json?
  createdById      String                 @map("created_by_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(3)
  lesson           Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Media is never cascade-deleted: content history must not disappear when a
  /// binary asset is retired or a future hard-delete workflow is introduced.
  mediaFile        MediaFile?             @relation(fields: [mediaFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        User                   @relation("LessonContentBlockCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  progress         BlockProgress[]
  progressEvents   ProgressEvent[]

  @@index([mediaFileId], map: "lesson_content_blocks_media_file_id_idx")
  @@index([lessonId, deletedAt, position], map: "lesson_content_blocks_lesson_id_deleted_at_position_idx")
  @@index([lessonId, blockType, deletedAt], map: "lesson_content_blocks_lesson_id_block_type_deleted_at_idx")
  @@index([lessonId, isVisible, deletedAt, position], map: "lesson_blocks_lesson_visibility_position_idx")
  @@index([createdById], map: "lesson_content_blocks_created_by_id_idx")
  @@index([deletedAt], map: "lesson_content_blocks_deleted_at_idx")
  @@map("lesson_content_blocks")
}

/// Binary payloads are stored behind a MediaStorage interface. This table keeps
/// only trusted metadata and an opaque provider-relative storage path.
model MediaFile {
  id                  String               @id @default(uuid(7)) @db.Uuid
  originalFileName    String               @map("original_file_name") @db.VarChar(255)
  storedFileName      String               @unique(map: "media_files_stored_file_name_key") @map("stored_file_name") @db.VarChar(255)
  mimeType            String               @map("mime_type") @db.VarChar(160)
  extension           String               @db.VarChar(16)
  category            MediaCategory
  sizeBytes           BigInt               @map("size_bytes") @db.BigInt
  /// Never expose this provider-relative path directly to API consumers.
  storagePath         String               @unique(map: "media_files_storage_path_key") @map("storage_path") @db.VarChar(512)
  storageProvider     MediaStorageProvider @default(LOCAL) @map("storage_provider")
  checksum            String?              @db.Char(64)
  uploadedById        String               @map("uploaded_by_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  uploadedBy          User                 @relation("MediaFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessonContentBlocks LessonContentBlock[]

  @@index([uploadedById, deletedAt, createdAt], map: "media_files_uploaded_by_id_deleted_at_created_at_idx")
  @@index([category, deletedAt, createdAt], map: "media_files_category_deleted_at_created_at_idx")
  @@index([checksum], map: "media_files_checksum_idx")
  @@index([deletedAt], map: "media_files_deleted_at_idx")
  @@map("media_files")
}
