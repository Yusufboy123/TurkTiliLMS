generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED

  @@map("user_status")
}

enum RoleCode {
  ADMIN
  TEACHER
  STUDENT

  @@map("role_code")
}

enum SessionClientType {
  WEB
  ANDROID
  IOS
  TELEGRAM
  OTHER

  @@map("session_client_type")
}

enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("course_level")
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("course_status")
}

enum CourseEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED

  @@map("course_enrollment_status")
}

enum CourseEnrollmentSource {
  SELF
  ADMIN

  @@map("course_enrollment_source")
}

/// NOT_STARTED is intentionally absent: a missing BlockProgress row represents
/// that state under the approved sparse progress model.
enum BlockProgressState {
  INCOMPLETE
  COMPLETED

  @@map("block_progress_state")
}

/// NOT_STARTED and READY_TO_COMPLETE are derived projections and are not stored.
enum LessonProgressState {
  IN_PROGRESS
  COMPLETED

  @@map("lesson_progress_state")
}

enum ProgressEventType {
  BLOCK_COMPLETED
  BLOCK_REOPENED
  LESSON_COMPLETED
  LESSON_REOPENED
  COURSE_COMPLETED

  @@map("progress_event_type")
}

/// This shared event vocabulary records before/after state without exposing
/// internal event rows through the public API.
enum ProgressEventState {
  NOT_STARTED
  INCOMPLETE
  IN_PROGRESS
  COMPLETED

  @@map("progress_event_state")
}

enum IdempotencyOperation {
  COMPLETE_BLOCK
  REOPEN_BLOCK
  COMPLETE_LESSON
  REOPEN_LESSON
  RECORD_LAST_VISITED_LESSON
  ISSUE_CERTIFICATE
  REVOKE_CERTIFICATE

  @@map("idempotency_operation")
}

/// NOT_ISSUED is derived from the absence of a Certificate row.
enum CertificateLifecycleStatus {
  ISSUED
  REVOKED

  @@map("certificate_lifecycle_status")
}

enum CertificateRevocationReasonCode {
  FRAUD
  ADMINISTRATIVE_ERROR
  DUPLICATE_ISSUANCE
  POLICY_VIOLATION
  OTHER

  @@map("certificate_revocation_reason_code")
}

enum CertificateTemplateVersionStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("certificate_template_version_status")
}

/// Module 8.6B persists provider-neutral metadata only. Additional durable
/// providers require a later reviewed additive enum migration.
enum CertificateArtifactStorageProvider {
  LOCAL

  @@map("certificate_artifact_storage_provider")
}

enum StepUpAction {
  CERTIFICATE_ISSUE
  CERTIFICATE_REVOKE

  @@map("step_up_action")
}

enum StepUpTargetType {
  ENROLLMENT
  CERTIFICATE

  @@map("step_up_target_type")
}

enum StepUpContinuation {
  CERTIFICATE_ISSUE_CONFIRMATION
  CERTIFICATE_REVOKE_CONFIRMATION

  @@map("step_up_continuation")
}

enum CertificateEligibilityPolicyCode {
  COURSE_COMPLETION_ONLY

  @@map("certificate_eligibility_policy_code")
}

enum CertificateEligibilityAssessmentRule {
  NONE

  @@map("certificate_eligibility_assessment_rule")
}

/// NOT_COMPLETED is derived and intentionally absent from persisted evidence.
/// NOT_ELIGIBLE is reserved for a future approved policy and is blocked by the
/// v1 PostgreSQL CHECK constraint.
enum CertificateEligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE

  @@map("certificate_eligibility_status")
}

enum CertificateEligibilityReasonCode {
  COURSE_NOT_COMPLETED
  ZERO_ELIGIBLE_LESSONS
  COMPLETION_EVIDENCE_UNAVAILABLE
  POLICY_REQUIREMENTS_NOT_MET

  @@map("certificate_eligibility_reason_code")
}

enum CertificateEligibilityEvaluatorType {
  SYSTEM
  USER

  @@map("certificate_eligibility_evaluator_type")
}

enum LessonType {
  TEXT
  VIDEO
  AUDIO
  PDF
  QUIZ
  ASSIGNMENT
  LIVE

  @@map("lesson_type")
}

enum LessonStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("lesson_status")
}

enum LessonContentBlockType {
  TEXT
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  IMAGE
  LINK
  DOWNLOAD

  @@map("lesson_content_block_type")
}

enum MediaCategory {
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO

  @@map("media_category")
}

enum MediaStorageProvider {
  LOCAL

  @@map("media_storage_provider")
}

model User {
  id                         String                             @id @default(uuid(7)) @db.Uuid
  email                      String                             @unique(map: "users_email_key") @db.Citext
  firstName                  String?                            @map("first_name") @db.VarChar(100)
  lastName                   String?                            @map("last_name") @db.VarChar(100)
  displayName                String?                            @map("display_name") @db.VarChar(160)
  status                     UserStatus                         @default(ACTIVE)
  emailVerifiedAt            DateTime?                          @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt                DateTime?                          @map("last_login_at") @db.Timestamptz(3)
  deletedAt                  DateTime?                          @map("deleted_at") @db.Timestamptz(3)
  createdAt                  DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential                 UserCredential?
  sessions                   UserSession[]
  roles                      UserRole[]                         @relation("UserRoleUser")
  roleAssignmentsMade        UserRole[]                         @relation("UserRoleAssigner")
  permissionGrantsMade       RolePermission[]                   @relation("RolePermissionGranter")
  auditLogs                  AuditLog[]                         @relation("AuditLogActor")
  coursesCreated             Course[]                           @relation("CourseCreator")
  coursesTaught              Course[]                           @relation("CourseTeacher")
  courseSectionsCreated      CourseSection[]                    @relation("CourseSectionCreator")
  lessonsCreated             Lesson[]                           @relation("LessonCreator")
  lessonsTaught              Lesson[]                           @relation("LessonTeacher")
  lessonBlocksCreated        LessonContentBlock[]               @relation("LessonContentBlockCreator")
  mediaFilesUploaded         MediaFile[]                        @relation("MediaFileUploader")
  courseEnrollments          CourseEnrollment[]                 @relation("CourseEnrollmentStudent")
  enrollmentsCreated         CourseEnrollment[]                 @relation("CourseEnrollmentCreator")
  progressEvents             ProgressEvent[]                    @relation("ProgressEventActor")
  idempotencyRecords         IdempotencyRecord[]                @relation("IdempotencyRecordActor")
  eligibilityEvaluationsMade CertificateEligibilityEvaluation[] @relation("CertificateEligibilityEvaluator")
  certificatesIssued         Certificate[]                      @relation("CertificateIssuer")
  certificatesRevoked        Certificate[]                      @relation("CertificateRevoker")
  certificateDisclosures     CertificateDisclosureControl[]     @relation("CertificateDisclosureSuppressor")
  stepUpChallenges           StepUpChallenge[]                  @relation("StepUpChallengeUser")
  stepUpProofs               StepUpProof[]                      @relation("StepUpProofUser")

  @@index([status, createdAt], map: "users_status_created_at_idx")
  @@index([lastName, firstName], map: "users_last_name_first_name_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

/// Local password security state is isolated from the general user profile.
/// Only an adaptive password hash is stored; plaintext passwords never persist.
model UserCredential {
  userId                 String    @id @map("user_id") @db.Uuid
  passwordHash           String    @map("password_hash") @db.Text
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  lockedUntil            DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt      DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  requiresPasswordChange Boolean   @default(false) @map("requires_password_change")
  /// Password reset tokens are random, single-use values stored only as hashes.
  passwordResetTokenHash String?   @unique(map: "user_credentials_password_reset_token_hash_key") @map("password_reset_token_hash") @db.VarChar(128)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([lockedUntil], map: "user_credentials_locked_until_idx")
  @@index([passwordResetExpiresAt], map: "user_credentials_password_reset_expires_at_idx")
  @@map("user_credentials")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        RoleCode         @unique(map: "roles_code_key")
  name        String           @db.VarChar(100)
  description String?          @db.Text
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@index([isSystem], map: "roles_is_system_idx")
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique(map: "permissions_code_key") @db.VarChar(100)
  resource    String           @db.VarChar(64)
  action      String           @db.VarChar(64)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@unique([resource, action], map: "permissions_resource_action_key")
  @@map("permissions")
}

model UserRole {
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  user             User      @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role             Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy       User?     @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@id([userId, roleId], map: "user_roles_pkey")
  @@index([roleId, userId], map: "user_roles_role_id_user_id_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_user_id_idx")
  @@index([expiresAt], map: "user_roles_expires_at_idx")
  @@map("user_roles")
}

model RolePermission {
  roleId          String     @map("role_id") @db.Uuid
  permissionId    String     @map("permission_id") @db.Uuid
  grantedByUserId String?    @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime   @default(now()) @map("granted_at") @db.Timestamptz(3)
  role            Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy       User?      @relation("RolePermissionGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@id([roleId, permissionId], map: "role_permissions_pkey")
  @@index([permissionId, roleId], map: "role_permissions_permission_id_role_id_idx")
  @@index([grantedByUserId], map: "role_permissions_granted_by_user_id_idx")
  @@map("role_permissions")
}

model UserSession {
  id                  String            @id @default(uuid(7)) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  /// Refresh tokens are stored only as cryptographic hashes and are never recoverable.
  refreshTokenHash    String            @unique(map: "user_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.VarChar(128)
  tokenFamilyId       String            @map("token_family_id") @db.Uuid
  clientType          SessionClientType @default(WEB) @map("client_type")
  deviceName          String?           @map("device_name") @db.VarChar(160)
  /// Raw IP retention must be bounded; anonymize or hash it according to privacy policy.
  ipAddress           String?           @map("ip_address") @db.Inet
  userAgent           String?           @map("user_agent") @db.Text
  lastActivityAt      DateTime          @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// Password login and approved password step-up may advance this value.
  /// Refresh rotation and ordinary request activity must not advance it.
  lastAuthenticatedAt DateTime?         @map("last_authenticated_at") @db.Timestamptz(3)
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revocationReason    String?           @map("revocation_reason") @db.VarChar(255)
  replacedBySessionId String?           @unique(map: "user_sessions_replaced_by_session_id_key") @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy          UserSession?      @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces            UserSession?      @relation("SessionRotation")
  stepUpChallenges    StepUpChallenge[] @relation("StepUpChallengeSession")
  stepUpProofs        StepUpProof[]     @relation("StepUpProofSession")

  @@unique([id, userId], map: "user_sessions_id_user_id_key")
  @@index([userId, revokedAt, expiresAt], map: "user_sessions_user_id_revoked_at_expires_at_idx")
  @@index([tokenFamilyId], map: "user_sessions_token_family_id_idx")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@index([lastActivityAt], map: "user_sessions_last_activity_at_idx")
  @@map("user_sessions")
}

/// Audit records are append-only. Summaries must never contain passwords,
/// tokens, secrets, or unnecessary personal data.
model AuditLog {
  id                   String   @id @default(uuid(7)) @db.Uuid
  actorUserId          String?  @map("actor_user_id") @db.Uuid
  action               String   @db.VarChar(100)
  subjectType          String   @map("subject_type") @db.VarChar(100)
  subjectId            String?  @map("subject_id") @db.Uuid
  requestCorrelationId String?  @map("request_correlation_id") @db.Uuid
  ipHash               String?  @map("ip_hash") @db.Char(64)
  userAgentSummary     String?  @map("user_agent_summary") @db.VarChar(512)
  beforeSummary        Json?    @map("before_summary")
  afterSummary         Json?    @map("after_summary")
  metadata             Json?
  occurredAt           DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actor                User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorUserId, occurredAt], map: "audit_logs_actor_user_id_occurred_at_idx")
  @@index([subjectType, subjectId, occurredAt], map: "audit_logs_subject_type_subject_id_occurred_at_idx")
  @@index([action, occurredAt], map: "audit_logs_action_occurred_at_idx")
  @@index([requestCorrelationId], map: "audit_logs_request_correlation_id_idx")
  @@index([occurredAt], map: "audit_logs_occurred_at_idx")
  @@map("audit_logs")
}

/// Course content fields represent the course's current primary content language.
/// `contentLanguage` uses a BCP 47-compatible code so future languages are not
/// coupled to the initial Turkish catalog.
model Course {
  id                       String             @id @default(uuid(7)) @db.Uuid
  title                    String             @db.VarChar(200)
  slug                     String             @unique(map: "courses_slug_key") @db.VarChar(180)
  shortDescription         String?            @map("short_description") @db.VarChar(500)
  description              String?            @db.Text
  coverImageUrl            String?            @map("cover_image_url") @db.Text
  contentLanguage          String             @default("tr") @map("content_language") @db.VarChar(35)
  level                    CourseLevel?
  status                   CourseStatus       @default(DRAFT)
  createdByUserId          String             @map("created_by_user_id") @db.Uuid
  teacherId                String?            @map("teacher_id") @db.Uuid
  estimatedDurationMinutes Int?               @map("estimated_duration_minutes")
  sortOrder                Int                @default(0) @map("sort_order")
  isFeatured               Boolean            @default(false) @map("is_featured")
  curriculumVersion        Int                @default(1) @map("curriculum_version")
  publishedAt              DateTime?          @map("published_at") @db.Timestamptz(3)
  archivedAt               DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdBy                User               @relation("CourseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher                  User?              @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sections                 CourseSection[]
  lessons                  Lesson[]
  enrollments              CourseEnrollment[]

  @@index([status, deletedAt, sortOrder], map: "courses_status_deleted_at_sort_order_idx")
  @@index([teacherId, status, deletedAt], map: "courses_teacher_id_status_deleted_at_idx")
  @@index([createdByUserId], map: "courses_created_by_user_id_idx")
  @@index([level, status, deletedAt], map: "courses_level_status_deleted_at_idx")
  @@index([isFeatured, status, deletedAt], map: "courses_is_featured_status_deleted_at_idx")
  @@index([contentLanguage, status, deletedAt], map: "courses_content_language_status_deleted_at_idx")
  @@index([publishedAt], map: "courses_published_at_idx")
  @@index([deletedAt], map: "courses_deleted_at_idx")
  @@map("courses")
}

/// Enrollment rows are lifecycle records. A cancelled enrollment is retained and
/// a later explicit re-enrollment creates a new row so historical events remain auditable.
/// Current-membership uniqueness is enforced by a PostgreSQL partial unique index.
model CourseEnrollment {
  id                     String                             @id @default(uuid(7)) @db.Uuid
  courseId               String                             @map("course_id") @db.Uuid
  studentId              String                             @map("student_id") @db.Uuid
  status                 CourseEnrollmentStatus             @default(ACTIVE)
  source                 CourseEnrollmentSource
  enrolledAt             DateTime                           @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  startedAt              DateTime?                          @map("started_at") @db.Timestamptz(3)
  completedAt            DateTime?                          @map("completed_at") @db.Timestamptz(3)
  cancelledAt            DateTime?                          @map("cancelled_at") @db.Timestamptz(3)
  suspendedAt            DateTime?                          @map("suspended_at") @db.Timestamptz(3)
  createdById            String?                            @map("created_by_id") @db.Uuid
  createdAt              DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  course                 Course                             @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student                User                               @relation("CourseEnrollmentStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy              User?                              @relation("CourseEnrollmentCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  progressRoot           EnrollmentProgressRoot?
  eligibilityEvaluations CertificateEligibilityEvaluation[]
  certificate            Certificate?
  idempotencyRecords     IdempotencyRecord[]

  @@unique([id, courseId], map: "course_enrollments_id_course_id_key")
  @@index([studentId, status, enrolledAt], map: "course_enrollments_student_id_status_enrolled_at_idx")
  @@index([courseId, status, enrolledAt], map: "course_enrollments_course_id_status_enrolled_at_idx")
  @@index([courseId, studentId, enrolledAt], map: "course_enrollments_course_id_student_id_enrolled_at_idx")
  @@index([createdById], map: "course_enrollments_created_by_id_idx")
  @@index([completedAt], map: "course_enrollments_completed_at_idx")
  @@index([createdAt], map: "course_enrollments_created_at_idx")
  @@map("course_enrollments")
}

/// One root owns the authoritative snapshot and activity cursor for exactly one
/// enrollment lifecycle. Progress records are intentionally not soft-deleted.
model EnrollmentProgressRoot {
  id                      String                             @id @default(uuid(7)) @db.Uuid
  enrollmentId            String                             @unique(map: "enrollment_progress_roots_enrollment_id_key") @map("enrollment_id") @db.Uuid
  lastVisitedLessonId     String?                            @map("last_visited_lesson_id") @db.Uuid
  lastVisitedAt           DateTime?                          @map("last_visited_at") @db.Timestamptz(3)
  firstActivityAt         DateTime?                          @map("first_activity_at") @db.Timestamptz(3)
  completionVersion       Int                                @default(0) @map("completion_version")
  activityVersion         Int                                @default(0) @map("activity_version")
  curriculumVersion       Int                                @default(1) @map("curriculum_version")
  completedEligibleBlocks Int                                @default(0) @map("completed_eligible_blocks")
  totalEligibleBlocks     Int                                @default(0) @map("total_eligible_blocks")
  completedLessons        Int                                @default(0) @map("completed_lessons")
  totalEligibleLessons    Int                                @default(0) @map("total_eligible_lessons")
  coursePercentage        Int                                @default(0) @map("course_percentage")
  frozenAt                DateTime?                          @map("frozen_at") @db.Timestamptz(3)
  createdAt               DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment              CourseEnrollment                   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastVisitedLesson       Lesson?                            @relation("EnrollmentProgressLastVisitedLesson", fields: [lastVisitedLessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessonProgress          LessonProgress[]
  blockProgress           BlockProgress[]
  events                  ProgressEvent[]
  eligibilityEvaluations  CertificateEligibilityEvaluation[]

  @@index([lastVisitedAt, enrollmentId], map: "enrollment_progress_roots_last_visited_at_enrollment_id_idx")
  @@index([frozenAt], map: "enrollment_progress_roots_frozen_at_idx")
  @@map("enrollment_progress_roots")
}

/// Persisted lesson state is enrollment-scoped. NOT_STARTED and
/// READY_TO_COMPLETE remain derived so they cannot become stale stored states.
model LessonProgress {
  id                String                 @id @default(uuid(7)) @db.Uuid
  enrollmentId      String                 @map("enrollment_id") @db.Uuid
  lessonId          String                 @map("lesson_id") @db.Uuid
  state             LessonProgressState    @default(IN_PROGRESS)
  curriculumVersion Int                    @map("curriculum_version")
  firstActivityAt   DateTime               @default(now()) @map("first_activity_at") @db.Timestamptz(3)
  lastActivityAt    DateTime               @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  progressRoot      EnrollmentProgressRoot @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict, onUpdate: Cascade)
  lesson            Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, lessonId], map: "lesson_progress_enrollment_id_lesson_id_key")
  @@index([enrollmentId, state, lessonId], map: "lesson_progress_enrollment_id_state_lesson_id_idx")
  @@index([lessonId, state], map: "lesson_progress_lesson_id_state_idx")
  @@index([enrollmentId, lastActivityAt], map: "lesson_progress_enrollment_id_last_activity_at_idx")
  @@index([completedAt], map: "lesson_progress_completed_at_idx")
  @@map("lesson_progress")
}

/// A missing row is NOT_STARTED. Only explicit INCOMPLETE and COMPLETED states
/// are persisted, preserving sparse storage and reopen history.
model BlockProgress {
  id                String                 @id @default(uuid(7)) @db.Uuid
  enrollmentId      String                 @map("enrollment_id") @db.Uuid
  blockId           String                 @map("block_id") @db.Uuid
  state             BlockProgressState
  curriculumVersion Int                    @map("curriculum_version")
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  progressRoot      EnrollmentProgressRoot @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict, onUpdate: Cascade)
  block             LessonContentBlock     @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, blockId], map: "block_progress_enrollment_id_block_id_key")
  @@index([enrollmentId, state, blockId], map: "block_progress_enrollment_id_state_block_id_idx")
  @@index([blockId, state], map: "block_progress_block_id_state_idx")
  @@index([completedAt], map: "block_progress_completed_at_idx")
  @@map("block_progress")
}

/// Fixed-column, append-only progress history. It is neither a public event
/// stream nor an unrestricted analytics payload.
model ProgressEvent {
  id                              String                 @id @default(uuid(7)) @db.Uuid
  enrollmentId                    String                 @map("enrollment_id") @db.Uuid
  actorUserId                     String?                @map("actor_user_id") @db.Uuid
  eventType                       ProgressEventType      @map("event_type")
  lessonId                        String?                @map("lesson_id") @db.Uuid
  blockId                         String?                @map("block_id") @db.Uuid
  previousState                   ProgressEventState     @map("previous_state")
  newState                        ProgressEventState     @map("new_state")
  curriculumVersion               Int                    @map("curriculum_version")
  resultingCompletionVersion      Int                    @map("resulting_completion_version")
  idempotencyRecordId             String?                @map("idempotency_record_id") @db.Uuid
  requestCorrelationId            String?                @map("request_correlation_id") @db.Uuid
  snapshotCompletedEligibleBlocks Int?                   @map("snapshot_completed_eligible_blocks")
  snapshotTotalEligibleBlocks     Int?                   @map("snapshot_total_eligible_blocks")
  snapshotCompletedLessons        Int?                   @map("snapshot_completed_lessons")
  snapshotTotalEligibleLessons    Int?                   @map("snapshot_total_eligible_lessons")
  snapshotCoursePercentage        Int?                   @map("snapshot_course_percentage")
  occurredAt                      DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(3)
  progressRoot                    EnrollmentProgressRoot @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict, onUpdate: Cascade)
  actor                           User?                  @relation("ProgressEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lesson                          Lesson?                @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  block                           LessonContentBlock?    @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  idempotencyRecord               IdempotencyRecord?     @relation(fields: [idempotencyRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([enrollmentId, occurredAt], map: "progress_events_enrollment_id_occurred_at_idx")
  @@index([actorUserId, occurredAt], map: "progress_events_actor_user_id_occurred_at_idx")
  @@index([lessonId, occurredAt], map: "progress_events_lesson_id_occurred_at_idx")
  @@index([blockId, occurredAt], map: "progress_events_block_id_occurred_at_idx")
  @@index([eventType, occurredAt], map: "progress_events_event_type_occurred_at_idx")
  @@index([idempotencyRecordId], map: "progress_events_idempotency_record_id_idx")
  @@map("progress_events")
}

/// Successful mutation responses are retained for bounded actor-isolated
/// replay. Authentication and authorization must still be revalidated.
model IdempotencyRecord {
  id                          String               @id @default(uuid(7)) @db.Uuid
  actorUserId                 String               @map("actor_user_id") @db.Uuid
  enrollmentId                String               @map("enrollment_id") @db.Uuid
  key                         String               @db.VarChar(128)
  operation                   IdempotencyOperation
  requestFingerprint          String               @map("request_fingerprint") @db.Char(64)
  responseStatus              Int                  @map("response_status") @db.SmallInt
  responseEnvelope            Json                 @map("response_envelope")
  resultingCompletionVersion  Int?                 @map("resulting_completion_version")
  resultingActivityVersion    Int?                 @map("resulting_activity_version")
  resultingCertificateId      String?              @map("resulting_certificate_id") @db.Uuid
  resultingCertificateVersion Int?                 @map("resulting_certificate_version")
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt                   DateTime             @map("expires_at") @db.Timestamptz(3)
  actor                       User                 @relation("IdempotencyRecordActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment                  CourseEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resultingCertificate        Certificate?         @relation(fields: [resultingCertificateId, enrollmentId], references: [id, enrollmentId], onDelete: Restrict, onUpdate: Cascade, map: "idempotency_records_resulting_certificate_id_fkey")
  events                      ProgressEvent[]

  @@unique([actorUserId, key], map: "idempotency_records_actor_user_id_key_key")
  @@index([enrollmentId, createdAt], map: "idempotency_records_enrollment_id_created_at_idx")
  @@index([resultingCertificateId], map: "idempotency_records_resulting_certificate_id_idx")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@index([operation, createdAt], map: "idempotency_records_operation_created_at_idx")
  @@map("idempotency_records")
}

/// Policy versions are immutable. V1 supports only the completion-only policy
/// with no assessment, attendance, or manual-approval requirements.
model CertificateEligibilityPolicy {
  id                     String                               @id @default(uuid(7)) @db.Uuid
  code                   CertificateEligibilityPolicyCode
  version                Int
  assessmentRule         CertificateEligibilityAssessmentRule @default(NONE) @map("assessment_rule")
  requiresAttendance     Boolean                              @default(false) @map("requires_attendance")
  requiresManualApproval Boolean                              @default(false) @map("requires_manual_approval")
  createdAt              DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  evaluations            CertificateEligibilityEvaluation[]

  @@unique([code, version], map: "certificate_eligibility_policies_code_version_key")
  @@map("certificate_eligibility_policies")
}

/// Immutable enrollment-scoped eligibility evidence. Course and student
/// identity are trusted through the enrollment relation; mutable profile data
/// is deliberately not copied into this snapshot.
model CertificateEligibilityEvaluation {
  id                          String                              @id @default(uuid(7)) @db.Uuid
  enrollmentId                String                              @map("enrollment_id") @db.Uuid
  courseId                    String                              @map("course_id") @db.Uuid
  policyId                    String                              @map("policy_id") @db.Uuid
  status                      CertificateEligibilityStatus
  evaluationVersion           Int                                 @map("evaluation_version")
  evaluatedAt                 DateTime                            @map("evaluated_at") @db.Timestamptz(3)
  completedAt                 DateTime                            @map("completed_at") @db.Timestamptz(3)
  completionCurriculumVersion Int                                 @map("completion_curriculum_version")
  completionVersion           Int                                 @map("completion_version")
  completedLessons            Int                                 @map("completed_lessons")
  totalEligibleLessons        Int                                 @map("total_eligible_lessons")
  coursePercentage            Int                                 @map("course_percentage")
  evaluatorType               CertificateEligibilityEvaluatorType @default(SYSTEM) @map("evaluator_type")
  evaluatedByUserId           String?                             @map("evaluated_by_user_id") @db.Uuid
  supersedesEvaluationId      String?                             @unique(map: "eligibility_evaluations_supersedes_id_key") @map("supersedes_evaluation_id") @db.Uuid
  createdAt                   DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  enrollment                  CourseEnrollment                    @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: Cascade, map: "eligibility_evaluations_enrollment_course_fkey")
  progressRoot                EnrollmentProgressRoot              @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict, onUpdate: Cascade, map: "eligibility_evaluations_progress_root_fkey")
  policy                      CertificateEligibilityPolicy        @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "eligibility_evaluations_policy_id_fkey")
  evaluatedBy                 User?                               @relation("CertificateEligibilityEvaluator", fields: [evaluatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "eligibility_evaluations_evaluated_by_fkey")
  supersedes                  CertificateEligibilityEvaluation?   @relation("CertificateEligibilitySupersession", fields: [supersedesEvaluationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "eligibility_evaluations_supersedes_fkey")
  supersededBy                CertificateEligibilityEvaluation?   @relation("CertificateEligibilitySupersession")
  reasons                     CertificateEligibilityReason[]
  certificate                 Certificate?

  @@unique([id, enrollmentId, courseId], map: "eligibility_evaluations_id_enrollment_course_key")
  @@unique([enrollmentId, evaluationVersion], map: "eligibility_evaluations_enrollment_version_key")
  @@unique([enrollmentId, policyId, completionVersion], map: "eligibility_evaluations_snapshot_key")
  @@index([courseId, status, evaluatedAt], map: "eligibility_evaluations_course_status_at_idx")
  @@index([enrollmentId, status, evaluatedAt], map: "eligibility_evaluations_enrollment_status_at_idx")
  @@index([policyId, status, evaluatedAt], map: "eligibility_evaluations_policy_status_at_idx")
  @@index([evaluatedByUserId, evaluatedAt], map: "eligibility_evaluations_evaluator_at_idx")
  @@map("certificate_eligibility_evaluations")
}

/// Fixed reason codes remain normalized and contain no unrestricted metadata.
/// The v1 database guard rejects reasons for its only persisted state, ELIGIBLE.
model CertificateEligibilityReason {
  evaluationId String                           @map("evaluation_id") @db.Uuid
  code         CertificateEligibilityReasonCode
  createdAt    DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  evaluation   CertificateEligibilityEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "eligibility_reasons_evaluation_id_fkey")

  @@id([evaluationId, code], map: "certificate_eligibility_reasons_pkey")
  @@index([code, evaluationId], map: "certificate_eligibility_reasons_code_evaluation_id_idx")
  @@map("certificate_eligibility_reasons")
}

/// Stable administrative identity for a typed certificate template. Rendering
/// content belongs to immutable CertificateTemplateVersion rows.
model CertificateTemplate {
  id        String                       @id @default(uuid(7)) @db.Uuid
  code      String                       @unique(map: "certificate_templates_code_key") @db.VarChar(100)
  name      String                       @db.VarChar(160)
  createdAt DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions  CertificateTemplateVersion[]

  @@map("certificate_templates")
}

/// DRAFT rows are editable. Activation freezes every rendering input; the
/// migration trigger permits only the later ACTIVE -> RETIRED lifecycle change.
model CertificateTemplateVersion {
  id                      String                           @id @default(uuid(7)) @db.Uuid
  templateId              String                           @map("template_id") @db.Uuid
  version                 Int
  locale                  String                           @db.VarChar(35)
  status                  CertificateTemplateVersionStatus @default(DRAFT)
  rendererContractVersion String?                          @map("renderer_contract_version") @db.VarChar(64)
  organizationDisplayName String?                          @map("organization_display_name") @db.VarChar(200)
  organizationLegalName   String?                          @map("organization_legal_name") @db.VarChar(200)
  logoAssetId             String?                          @map("logo_asset_id") @db.VarChar(128)
  logoAssetChecksum       String?                          @map("logo_asset_checksum") @db.Char(64)
  sealAssetId             String?                          @map("seal_asset_id") @db.VarChar(128)
  sealAssetChecksum       String?                          @map("seal_asset_checksum") @db.Char(64)
  signatoryName           String?                          @map("signatory_name") @db.VarChar(160)
  signatoryTitle          String?                          @map("signatory_title") @db.VarChar(160)
  signatoryAssetId        String?                          @map("signatory_asset_id") @db.VarChar(128)
  signatoryAssetChecksum  String?                          @map("signatory_asset_checksum") @db.Char(64)
  fontAssetId             String?                          @map("font_asset_id") @db.VarChar(128)
  fontAssetChecksum       String?                          @map("font_asset_checksum") @db.Char(64)
  fontFamily              String?                          @map("font_family") @db.VarChar(100)
  fontVersion             String?                          @map("font_version") @db.VarChar(64)
  fontLicenseIdentifier   String?                          @map("font_license_identifier") @db.VarChar(100)
  fontLicenseProvenance   String?                          @map("font_license_provenance") @db.VarChar(500)
  activatedAt             DateTime?                        @map("activated_at") @db.Timestamptz(3)
  retiredAt               DateTime?                        @map("retired_at") @db.Timestamptz(3)
  createdAt               DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  template                CertificateTemplate              @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "certificate_template_versions_template_id_fkey")
  certificates            Certificate[]

  @@unique([templateId, version, locale], map: "certificate_template_versions_identity_key")
  @@index([templateId, locale, status], map: "certificate_template_versions_lookup_idx")
  @@index([status, locale], map: "certificate_template_versions_status_locale_idx")
  @@map("certificate_template_versions")
}

/// A row exists only after successful issuance. NOT_ISSUED remains derived.
/// Identity, evidence, rendering snapshots, and verification hash are immutable;
/// only the ISSUED -> REVOKED transition may update this row.
model Certificate {
  id                      String                           @id @default(uuid(7)) @db.Uuid
  certificateNumber       String                           @unique(map: "certificates_certificate_number_key") @default(dbgenerated("generate_certificate_number()")) @map("certificate_number") @db.VarChar(19)
  verificationTokenHash   String                           @unique(map: "certificates_verification_token_hash_key") @map("verification_token_hash") @db.Char(64)
  enrollmentId            String                           @unique(map: "certificates_enrollment_id_key") @map("enrollment_id") @db.Uuid
  courseId                String                           @map("course_id") @db.Uuid
  eligibilityEvaluationId String                           @unique(map: "certificates_eligibility_evaluation_id_key") @map("eligibility_evaluation_id") @db.Uuid
  templateVersionId       String                           @map("template_version_id") @db.Uuid
  status                  CertificateLifecycleStatus       @default(ISSUED)
  version                 Int                              @default(1)
  recipientDisplayName    String                           @map("recipient_display_name") @db.VarChar(160)
  courseTitle             String                           @map("course_title") @db.VarChar(200)
  organizationName        String                           @map("organization_name") @db.VarChar(200)
  locale                  String                           @db.VarChar(35)
  issueDate               DateTime                         @map("issue_date") @db.Date
  issuedAt                DateTime                         @default(now()) @map("issued_at") @db.Timestamptz(3)
  issuedByUserId          String                           @map("issued_by_user_id") @db.Uuid
  revokedAt               DateTime?                        @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId         String?                          @map("revoked_by_user_id") @db.Uuid
  revocationReasonCode    CertificateRevocationReasonCode? @map("revocation_reason_code")
  revocationReasonNote    String?                          @map("revocation_reason_note") @db.VarChar(500)
  createdAt               DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment              CourseEnrollment                 @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: Cascade, map: "certificates_enrollment_course_fkey")
  eligibilityEvaluation   CertificateEligibilityEvaluation @relation(fields: [eligibilityEvaluationId, enrollmentId, courseId], references: [id, enrollmentId, courseId], onDelete: Restrict, onUpdate: Cascade, map: "certificates_evaluation_enrollment_course_fkey")
  templateVersion         CertificateTemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "certificates_template_version_id_fkey")
  issuedBy                User                             @relation("CertificateIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "certificates_issued_by_user_id_fkey")
  revokedBy               User?                            @relation("CertificateRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "certificates_revoked_by_user_id_fkey")
  artifact                CertificateArtifact?
  disclosureControl       CertificateDisclosureControl?
  idempotencyResults      IdempotencyRecord[]

  @@unique([enrollmentId, courseId], map: "certificates_enrollment_course_key")
  @@unique([id, enrollmentId], map: "certificates_id_enrollment_id_key")
  @@unique([eligibilityEvaluationId, enrollmentId, courseId], map: "certificates_evaluation_enrollment_course_key")
  @@index([enrollmentId, status], map: "certificates_enrollment_id_status_idx")
  @@index([courseId, status, issuedAt], map: "certificates_course_id_status_issued_at_idx")
  @@index([templateVersionId], map: "certificates_template_version_id_idx")
  @@index([issuedByUserId, issuedAt], map: "certificates_issued_by_user_id_issued_at_idx")
  @@index([revokedByUserId, revokedAt], map: "certificates_revoked_by_user_id_revoked_at_idx")
  @@map("certificates")
}

/// Immutable metadata for the one private canonical PDF. No file is created by
/// Module 8.6B and this row has no generic media deletion or restore lifecycle.
model CertificateArtifact {
  id                 String                             @id @default(uuid(7)) @db.Uuid
  certificateId      String                             @unique(map: "certificate_artifacts_certificate_id_key") @map("certificate_id") @db.Uuid
  storageProvider    CertificateArtifactStorageProvider @default(LOCAL) @map("storage_provider")
  storageKey         String                             @unique(map: "certificate_artifacts_storage_key_key") @map("storage_key") @db.VarChar(512)
  mimeType           String                             @default("application/pdf") @map("mime_type") @db.VarChar(64)
  sizeBytes          BigInt                             @map("size_bytes") @db.BigInt
  checksum           String                             @db.Char(64)
  rendererIdentifier String                             @map("renderer_identifier") @db.VarChar(100)
  rendererVersion    String                             @map("renderer_version") @db.VarChar(64)
  finalizedAt        DateTime                           @map("finalized_at") @db.Timestamptz(3)
  createdAt          DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  certificate        Certificate                        @relation(fields: [certificateId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "certificate_artifacts_certificate_id_fkey")

  @@index([checksum], map: "certificate_artifacts_checksum_idx")
  @@index([storageProvider, finalizedAt], map: "certificate_artifacts_provider_finalized_at_idx")
  @@index([finalizedAt], map: "certificate_artifacts_finalized_at_idx")
  @@map("certificate_artifacts")
}

/// Public recipient-name suppression is independent from immutable credential
/// evidence. Absence means no suppression record exists.
model CertificateDisclosureControl {
  id                        String      @id @default(uuid(7)) @db.Uuid
  certificateId             String      @unique(map: "certificate_disclosure_controls_certificate_id_key") @map("certificate_id") @db.Uuid
  recipientNameSuppressedAt DateTime?   @map("recipient_name_suppressed_at") @db.Timestamptz(3)
  suppressedByUserId        String?     @map("suppressed_by_user_id") @db.Uuid
  reasonCode                String?     @map("reason_code") @db.VarChar(64)
  createdAt                 DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  certificate               Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "certificate_disclosure_controls_certificate_id_fkey")
  suppressedBy              User?       @relation("CertificateDisclosureSuppressor", fields: [suppressedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "certificate_disclosure_controls_suppressed_by_user_id_fkey")

  @@index([recipientNameSuppressedAt], map: "certificate_disclosure_controls_suppressed_at_idx")
  @@index([suppressedByUserId, recipientNameSuppressedAt], map: "certificate_disclosure_controls_actor_suppressed_at_idx")
  @@map("certificate_disclosure_controls")
}

/// Five-minute, target-bound persistence foundation for future password step-up.
/// Only a nonce hash and credential epoch are retained.
model StepUpChallenge {
  id              String             @id @default(uuid(7)) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  sessionId       String             @map("session_id") @db.Uuid
  nonceHash       String             @unique(map: "step_up_challenges_nonce_hash_key") @map("nonce_hash") @db.Char(64)
  credentialEpoch DateTime           @map("credential_epoch") @db.Timestamptz(3)
  action          StepUpAction
  targetType      StepUpTargetType   @map("target_type")
  targetId        String             @map("target_id") @db.Uuid
  continuation    StepUpContinuation
  continuationId  String             @unique(map: "step_up_challenges_continuation_id_key") @map("continuation_id") @db.Uuid
  attemptCount    Int                @default(0) @map("attempt_count")
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz(3)
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(3)
  lockedAt        DateTime?          @map("locked_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User               @relation("StepUpChallengeUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "step_up_challenges_user_id_fkey")
  session         UserSession        @relation("StepUpChallengeSession", fields: [sessionId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade, map: "step_up_challenges_session_user_fkey")
  proof           StepUpProof?

  @@unique([id, userId, sessionId, credentialEpoch, action, targetType, targetId], map: "step_up_challenges_proof_binding_key")
  @@index([userId, sessionId, expiresAt], map: "step_up_challenges_user_session_expires_at_idx")
  @@index([targetType, targetId, action], map: "step_up_challenges_target_action_idx")
  @@index([expiresAt, lockedAt], map: "step_up_challenges_expires_locked_at_idx")
  @@map("step_up_challenges")
}

/// The raw 256-bit proof is returned once and never persisted. This row stores
/// its SHA-256 hash and the immutable challenge bindings only.
model StepUpProof {
  id              String           @id @default(uuid(7)) @db.Uuid
  challengeId     String           @unique(map: "step_up_proofs_challenge_id_key") @map("challenge_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  sessionId       String           @map("session_id") @db.Uuid
  proofHash       String           @unique(map: "step_up_proofs_proof_hash_key") @map("proof_hash") @db.Char(64)
  credentialEpoch DateTime         @map("credential_epoch") @db.Timestamptz(3)
  action          StepUpAction
  targetType      StepUpTargetType @map("target_type")
  targetId        String           @map("target_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  challenge       StepUpChallenge  @relation(fields: [challengeId, userId, sessionId, credentialEpoch, action, targetType, targetId], references: [id, userId, sessionId, credentialEpoch, action, targetType, targetId], onDelete: Restrict, onUpdate: Cascade, map: "step_up_proofs_challenge_binding_fkey")
  user            User             @relation("StepUpProofUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "step_up_proofs_user_id_fkey")
  session         UserSession      @relation("StepUpProofSession", fields: [sessionId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade, map: "step_up_proofs_session_user_fkey")

  @@unique([challengeId, userId, sessionId, credentialEpoch, action, targetType, targetId], map: "step_up_proofs_challenge_binding_key")
  @@index([userId, sessionId, expiresAt, consumedAt], map: "step_up_proofs_user_session_active_idx")
  @@index([expiresAt, consumedAt], map: "step_up_proofs_expires_consumed_at_idx")
  @@index([targetType, targetId, action], map: "step_up_proofs_target_action_idx")
  @@map("step_up_proofs")
}

model CourseSection {
  id          String    @id @default(uuid(7)) @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String?   @db.Text
  /// Active sibling uniqueness is enforced by a PostgreSQL partial index in
  /// the migration so soft-deleted rows can retain their historical position.
  position    Int
  isPublished Boolean   @default(false) @map("is_published")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User      @relation("CourseSectionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessons     Lesson[]

  @@unique([id, courseId], map: "course_sections_id_course_id_key")
  @@index([courseId, deletedAt, position], map: "course_sections_course_id_deleted_at_position_idx")
  @@index([courseId, isPublished, deletedAt], map: "course_sections_course_id_is_published_deleted_at_idx")
  @@index([createdById], map: "course_sections_created_by_id_idx")
  @@index([deletedAt], map: "course_sections_deleted_at_idx")
  @@map("course_sections")
}

model Lesson {
  id                       String                   @id @default(uuid(7)) @db.Uuid
  courseId                 String                   @map("course_id") @db.Uuid
  sectionId                String                   @map("section_id") @db.Uuid
  title                    String                   @db.VarChar(200)
  slug                     String                   @db.VarChar(180)
  summary                  String?                  @db.Text
  content                  String?                  @db.Text
  lessonType               LessonType               @map("lesson_type")
  /// Active sibling uniqueness is enforced by a PostgreSQL partial index in
  /// the migration so soft-deleted rows can retain their historical position.
  position                 Int
  durationMinutes          Int?                     @map("duration_minutes")
  isPreview                Boolean                  @default(false) @map("is_preview")
  status                   LessonStatus             @default(DRAFT)
  createdById              String                   @map("created_by_id") @db.Uuid
  teacherId                String?                  @map("teacher_id") @db.Uuid
  publishedAt              DateTime?                @map("published_at") @db.Timestamptz(3)
  archivedAt               DateTime?                @map("archived_at") @db.Timestamptz(3)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?                @map("deleted_at") @db.Timestamptz(3)
  course                   Course                   @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  section                  CourseSection            @relation(fields: [sectionId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: Cascade)
  createdBy                User                     @relation("LessonCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher                  User?                    @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contentBlocks            LessonContentBlock[]
  lastVisitedProgressRoots EnrollmentProgressRoot[] @relation("EnrollmentProgressLastVisitedLesson")
  progress                 LessonProgress[]
  progressEvents           ProgressEvent[]

  @@unique([courseId, slug], map: "lessons_course_id_slug_key")
  @@index([courseId, status, deletedAt], map: "lessons_course_id_status_deleted_at_idx")
  @@index([sectionId, deletedAt, position], map: "lessons_section_id_deleted_at_position_idx")
  @@index([teacherId, status, deletedAt], map: "lessons_teacher_id_status_deleted_at_idx")
  @@index([lessonType, status, deletedAt], map: "lessons_lesson_type_status_deleted_at_idx")
  @@index([createdById], map: "lessons_created_by_id_idx")
  @@index([deletedAt], map: "lessons_deleted_at_idx")
  @@map("lessons")
}

/// Ordered lesson content keeps delivery references and metadata only. Binary
/// payload ownership belongs to MediaFile and its storage-provider adapter.
model LessonContentBlock {
  id               String                 @id @default(uuid(7)) @db.Uuid
  lessonId         String                 @map("lesson_id") @db.Uuid
  mediaFileId      String?                @map("media_file_id") @db.Uuid
  blockType        LessonContentBlockType @map("block_type")
  title            String?                @db.VarChar(200)
  description      String?                @db.Text
  /// Active sibling uniqueness is enforced by a PostgreSQL partial index in
  /// the migration so soft-deleted blocks retain their historical position.
  position         Int
  isRequired       Boolean                @default(true) @map("is_required")
  isVisible        Boolean                @default(true) @map("is_visible")
  textContent      String?                @map("text_content") @db.Text
  sourceUrl        String?                @map("source_url") @db.Text
  externalProvider String?                @map("external_provider") @db.VarChar(100)
  fileName         String?                @map("file_name") @db.VarChar(255)
  originalFileName String?                @map("original_file_name") @db.VarChar(255)
  fileUrl          String?                @map("file_url") @db.Text
  mimeType         String?                @map("mime_type") @db.VarChar(160)
  fileSizeBytes    BigInt?                @map("file_size_bytes") @db.BigInt
  durationSeconds  Int?                   @map("duration_seconds")
  thumbnailUrl     String?                @map("thumbnail_url") @db.Text
  metadata         Json?
  createdById      String                 @map("created_by_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(3)
  lesson           Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Media is never cascade-deleted: content history must not disappear when a
  /// binary asset is retired or a future hard-delete workflow is introduced.
  mediaFile        MediaFile?             @relation(fields: [mediaFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        User                   @relation("LessonContentBlockCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  progress         BlockProgress[]
  progressEvents   ProgressEvent[]

  @@index([mediaFileId], map: "lesson_content_blocks_media_file_id_idx")
  @@index([lessonId, deletedAt, position], map: "lesson_content_blocks_lesson_id_deleted_at_position_idx")
  @@index([lessonId, blockType, deletedAt], map: "lesson_content_blocks_lesson_id_block_type_deleted_at_idx")
  @@index([lessonId, isVisible, deletedAt, position], map: "lesson_blocks_lesson_visibility_position_idx")
  @@index([createdById], map: "lesson_content_blocks_created_by_id_idx")
  @@index([deletedAt], map: "lesson_content_blocks_deleted_at_idx")
  @@map("lesson_content_blocks")
}

/// Binary payloads are stored behind a MediaStorage interface. This table keeps
/// only trusted metadata and an opaque provider-relative storage path.
model MediaFile {
  id                  String               @id @default(uuid(7)) @db.Uuid
  originalFileName    String               @map("original_file_name") @db.VarChar(255)
  storedFileName      String               @unique(map: "media_files_stored_file_name_key") @map("stored_file_name") @db.VarChar(255)
  mimeType            String               @map("mime_type") @db.VarChar(160)
  extension           String               @db.VarChar(16)
  category            MediaCategory
  sizeBytes           BigInt               @map("size_bytes") @db.BigInt
  /// Never expose this provider-relative path directly to API consumers.
  storagePath         String               @unique(map: "media_files_storage_path_key") @map("storage_path") @db.VarChar(512)
  storageProvider     MediaStorageProvider @default(LOCAL) @map("storage_provider")
  checksum            String?              @db.Char(64)
  uploadedById        String               @map("uploaded_by_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  uploadedBy          User                 @relation("MediaFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessonContentBlocks LessonContentBlock[]

  @@index([uploadedById, deletedAt, createdAt], map: "media_files_uploaded_by_id_deleted_at_created_at_idx")
  @@index([category, deletedAt, createdAt], map: "media_files_category_deleted_at_created_at_idx")
  @@index([checksum], map: "media_files_checksum_idx")
  @@index([deletedAt], map: "media_files_deleted_at_idx")
  @@map("media_files")
}
